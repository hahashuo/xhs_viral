# 复制为 .env 并填写。.env 不会提交到 GitHub。

# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 豆包 / 火山方舟（https://console.volcengine.com/ark）
# DOUBAO_MODEL 填方舟控制台里的模型名或推理接入点 ID（ep-xxxx）
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- 评测（python -m evals）用，日常发笔记不需要 ----
# Claude API key（https://console.anthropic.com → API Keys）。评测里 Claude 既是被测 agent 之一，也是默认 judge。
ANTHROPIC_API_KEY=
# 可选：评测用的 Claude 模型，默认 claude-opus-5-5
EVAL_CLAUDE_MODEL=
# 可选：judge 用哪个后端：claude（默认）/ deepseek / doubao
EVAL_JUDGE_BACKEND=
